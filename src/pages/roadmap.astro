---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { milestones, history } from '../data/milestones';
---
<BaseLayout title="Roadmap" description="Track HORUS OS development history and engineering milestones.">
<div class="ambient-background"></div><div class="precision-cursor" aria-hidden="true"></div><Header />
<main class="roadmap-page"><div class="container container--lg"><header class="page-header"><p class="page-kicker">Roadmap / Verification</p><h1 class="page-title">The work, in sequence.</h1><p class="page-lead">Engineering milestones and project history for HORUS OS. Status reflects actual completion, not projected timelines.</p></header>
<section class="history-section"><div class="roadmap-section-head"><p class="section-index">ARCHIVE / 00</p><div><h2>History is part of the system.</h2><p>Development has moved through pauses, restarts, and a change of foundation. This record keeps the current work legible.</p></div></div><div class="history-timeline">{history.map((event) => <article class="history-event"><time class="history-date" datetime={event.date}>{event.date.startsWith('~') ? event.date : new Date(event.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time><div><h3>{event.label}</h3><p>{event.description}</p></div></article>)}</div></section>
<section class="milestones-section"><div class="roadmap-section-head"><p class="section-index">CURRENT / 01—06</p><div><h2>Current engineering milestones.</h2><p>Six milestones tracking core infrastructure development. Progress is based on verified completion, not target dates.</p></div></div><div class="roadmap-timeline" id="roadmap-timeline"><div class="timeline-progress" id="timeline-progress" aria-hidden="true"></div>{milestones.map((milestone, index) => <article class={`milestone milestone--${milestone.status}`} data-milestone={milestone.id}><div class="milestone-marker" aria-hidden="true"><span>{milestone.id}</span></div><div class="milestone-content"><div class="milestone-meta"><span class="milestone-status">{milestone.status === 'complete' ? 'Verified complete' : milestone.status === 'in-progress' ? 'In progress' : 'Planned'}</span><span class="milestone-sequence">0{index + 1} / 06</span></div><h3>{milestone.title}</h3><p>{milestone.description}</p></div></article>)}</div></section>
<section class="roadmap-note"><p class="section-index">READ THE STATUS</p><p>{milestones.filter(m => m.status === 'complete').length} of {milestones.length} milestones are complete. Dates are not assigned to planned work.</p></section>
</div></main><Footer />
<script src="../scripts/roadmap-progress.ts"></script><script src="../scripts/ambient-background.ts"></script><script src="../scripts/precision-cursor.ts"></script>
</BaseLayout>
<style>
.roadmap-page { padding-bottom: var(--space-3xl); }.roadmap-section-head { display: grid; grid-template-columns: .7fr 1.3fr; gap: 4rem; margin-bottom: 3rem; }.roadmap-section-head h2 { max-width: 14ch; margin-bottom: 1rem; font-size: var(--font-size-2xl); }.roadmap-section-head p:not(.section-index) { max-width: 55ch; color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }.history-section { padding-block: var(--space-3xl); border-bottom: 1px solid var(--color-border-subtle); }.history-timeline { margin-left: calc(25% + 1rem); border-left: 1px solid var(--color-border); }.history-event { position: relative; display: grid; grid-template-columns: minmax(9rem, 11rem) minmax(0, 1fr); gap: 2rem; padding: 0 0 2.5rem 2rem; }.history-event::before { content: ''; position: absolute; top: .35rem; left: -4px; width: 7px; height: 7px; background: var(--color-gold-primary); }.history-event:last-child { padding-bottom: 0; }.history-date { color: var(--color-gold-accent); font: .68rem var(--font-family-mono); text-transform: uppercase; letter-spacing: .08em; }.history-event h3 { margin-bottom: .4rem; font-size: var(--font-size-lg); }.history-event p { color: var(--color-text-muted); font-size: .9rem; line-height: 1.7; }.milestones-section { padding-block: var(--space-3xl); }.roadmap-timeline { position: relative; max-width: 76rem; margin-left: calc(25% + 1rem); padding-left: 2rem; }.timeline-progress { position: absolute; top: 0; left: -1px; width: 2px; min-height: 0; background: var(--color-gold-primary); transform-origin: top; }.milestone { position: relative; display: grid; grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); gap: 2rem; min-height: 12rem; padding-bottom: 3rem; opacity: .5; transition: opacity var(--duration-base) var(--ease-out); }.milestone.active { opacity: 1; }.milestone-marker { position: absolute; left: -2.55rem; top: 0; display: grid; place-items: center; width: 4.2rem; height: 1.7rem; border: 1px solid var(--color-border); background: var(--color-bg-primary); color: var(--color-text-muted); font: .65rem var(--font-family-mono); }.milestone.active .milestone-marker { border-color: var(--color-gold-primary); color: var(--color-gold-primary); }.milestone-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; color: var(--color-gold-accent); font: .65rem var(--font-family-mono); letter-spacing: .08em; text-transform: uppercase; }.milestone-meta span { min-width: 0; }.milestone-content { grid-column: 1 / -1; min-width: 0; }.milestone-content h3 { max-width: 30ch; margin-top: 1rem; font-size: var(--font-size-xl); overflow-wrap: break-word; }.milestone-content p { max-width: 64ch; margin-top: .9rem; color: var(--color-text-secondary); line-height: 1.7; }.milestone--complete .milestone-meta span:first-child { color: var(--color-success); }.milestone--in-progress .milestone-meta span:first-child { color: var(--color-warning); }.roadmap-note { display: grid; grid-template-columns: .7fr 1.3fr; gap: 4rem; padding-block: 2rem; border-top: 1px solid var(--color-border); }.roadmap-note p:last-child { color: var(--color-text-secondary); }@media(max-width:700px){.roadmap-section-head,.roadmap-note{grid-template-columns:1fr;gap:1.25rem}.history-timeline,.roadmap-timeline{margin-left:0}.history-event{grid-template-columns:1fr;gap:.5rem}.milestone{grid-template-columns:1fr}.milestone-meta{padding-left:3rem}.milestone-marker{left:-.5rem}.roadmap-timeline{padding-left:2rem}}
</style>

<style>
  .roadmap-timeline { padding-left: 3.75rem; }
  .milestone { display: grid; grid-template-columns: 4.75rem minmax(0, 1fr) !important; gap: 1.5rem; min-height: 0; padding-bottom: 3.5rem; }
  .milestone-marker { position: static !important; inset: auto !important; left: auto !important; top: auto !important; grid-column: 1; grid-row: 1; align-self: start; justify-self: start; width: 3.75rem; height: 1.85rem; z-index: 2; }
  .milestone-content { grid-column: 2 !important; grid-row: 1; min-width: 0; }
  .milestone-meta { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; min-height: 1.85rem; gap: .5rem 1rem; padding-top: .15rem; }
  .milestone-status, .milestone-sequence { min-width: 0; line-height: 1.35; }
  .milestone-sequence { margin-left: auto; color: var(--color-text-muted); white-space: nowrap; }
  .milestone-content h3 { max-width: 34ch; margin-top: .8rem; line-height: 1.12; overflow-wrap: normal; }
  .milestone-content p { max-width: 68ch; margin-top: .85rem; }
  .timeline-progress { left: 1.875rem; }
  @media (max-width: 700px) {
    .roadmap-timeline { padding-left: 2.75rem; }
    .milestone { grid-template-columns: 3.75rem minmax(0, 1fr) !important; gap: 1rem; padding-bottom: 2.75rem; }
    .milestone-marker { width: 3.5rem; }
    .timeline-progress { left: 1.75rem; }
    .milestone-meta { align-items: flex-start; }
    .milestone-sequence { margin-left: 0; }
    .milestone-content h3 { max-width: 28ch; font-size: clamp(1.2rem, 5.2vw, 1.55rem); }
  }
</style>
