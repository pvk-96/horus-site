---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { milestones, history } from '../data/milestones';
---

<BaseLayout
  title="Roadmap"
  description="Track the development progress of HORUS OS through its engineering milestones and project history."
>
  <div class="ambient-background"></div>
  <div class="precision-cursor" aria-hidden="true"></div>

  <Header />

  <main>
    <article class="roadmap-page">
      <div class="container container--lg">
        <header class="page-header">
          <h1 class="page-title">Development Roadmap</h1>
          <p class="page-lead">
            Engineering milestones and project history for HORUS OS. Status reflects actual completion, not projected timelines.
          </p>
        </header>

        <!-- History Timeline -->
        <section class="history-section">
          <h2 class="section-heading">Project History</h2>
          <div class="history-timeline">
            {history.map((event) => (
              <div class="history-event">
                <div class="history-marker" aria-hidden="true"></div>
                <div class="history-content">
                  <time class="history-date" datetime={event.date}>
                    {event.date.startsWith('~') ? event.date : new Date(event.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  <h3 class="history-label">{event.label}</h3>
                  <p class="history-description">{event.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Current Milestones -->
        <section class="milestones-section">
          <h2 class="section-heading">Current Engineering Milestones</h2>
          <p class="milestones-intro">
            Six milestones tracking core infrastructure development. Progress is based on verified completion, not target dates.
          </p>

          <div class="roadmap-timeline" id="roadmap-timeline">
            <div class="timeline-progress" id="timeline-progress" aria-hidden="true"></div>

            {milestones.map((milestone, index) => (
              <div
                class={`milestone milestone--${milestone.status}`}
                data-milestone={milestone.id}
                data-index={index}
              >
                <div class="milestone-marker" aria-hidden="true">
                  <span class="milestone-number">{index + 1}</span>
                </div>
                <div class="milestone-content">
                  <div class="milestone-header">
                    <span class="milestone-id">{milestone.id}</span>
                    <span class={`milestone-badge milestone-badge--${milestone.status}`}>
                      {milestone.status === 'complete' ? 'Complete' :
                       milestone.status === 'in-progress' ? 'In Progress' : 'Planned'}
                    </span>
                  </div>
                  <h3 class="milestone-title">{milestone.title}</h3>
                  <p class="milestone-description">{milestone.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Status Summary -->
        <section class="status-summary">
          <div class="summary-card">
            <h3 class="summary-title">Development Status</h3>
            <p class="summary-text">
              {milestones.filter(m => m.status === 'complete').length} of {milestones.length} milestones complete.
              Focus is currently on installation workflow engineering and bootloader integration.
            </p>
            <p class="summary-note">
              Milestone completion reflects actual verified work, not estimated progress. Dates are not assigned to planned milestones.
            </p>
          </div>
        </section>
      </div>
    </article>
  </main>

  <Footer />

  <script src="../scripts/roadmap-progress.ts"></script>
  <script src="../scripts/ambient-background.ts"></script>
  <script src="../scripts/precision-cursor.ts"></script>
</BaseLayout>

<style>
  .roadmap-page {
    padding-block: var(--space-3xl);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .page-title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-md);
  }

  .page-lead {
    font-size: var(--font-size-xl);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    max-width: 48rem;
  }

  /* Section Headings */
  .section-heading {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  /* History Timeline */
  .history-section {
    margin-bottom: var(--space-3xl);
    padding: var(--space-2xl);
    background: var(--color-bg-surface);
    border-radius: var(--border-radius-lg);
  }

  .history-timeline {
    position: relative;
    padding-left: var(--space-xl);
  }

  .history-timeline::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }

  .history-event {
    position: relative;
    margin-bottom: var(--space-xl);
  }

  .history-event:last-child {
    margin-bottom: 0;
  }

  .history-marker {
    position: absolute;
    left: calc(-1 * var(--space-xl));
    top: 0;
    width: 9px;
    height: 9px;
    background: var(--color-accent);
    border-radius: 50%;
    border: 2px solid var(--color-bg-surface);
  }

  .history-date {
    display: block;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .history-label {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
  }

  .history-description {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* Milestones Section */
  .milestones-section {
    margin-bottom: var(--space-3xl);
  }

  .milestones-intro {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 42rem;
    margin: 0 auto var(--space-2xl);
  }

  .roadmap-timeline {
    position: relative;
    padding-left: var(--space-2xl);
  }

  .timeline-progress {
    position: absolute;
    left: 12px;
    top: 0;
    width: 2px;
    background: var(--color-accent);
    transition: height 0.6s ease;
  }

  .milestone {
    position: relative;
    margin-bottom: var(--space-2xl);
    opacity: 0.5;
    transition: opacity 0.4s ease;
  }

  .milestone.active {
    opacity: 1;
  }

  .milestone-marker {
    position: absolute;
    left: calc(-1 * var(--space-2xl));
    top: 0;
    width: 26px;
    height: 26px;
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border-subtle);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .milestone.active .milestone-marker {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .milestone-number {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
  }

  .milestone.active .milestone-number {
    color: var(--color-obsidian);
  }

  .milestone-content {
    padding: var(--space-lg);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--border-radius-md);
    transition: border-color 0.3s ease;
  }

  .milestone.active .milestone-content {
    border-color: var(--color-border);
  }

  .milestone-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .milestone-id {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
  }

  .milestone-badge {
    padding: 2px 8px;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .milestone-badge--complete {
    background: rgba(59, 165, 93, 0.2);
    color: var(--color-success);
  }

  .milestone-badge--in-progress {
    background: rgba(240, 180, 41, 0.2);
    color: var(--color-warning);
  }

  .milestone-badge--planned {
    background: rgba(161, 161, 170, 0.2);
    color: var(--color-text-muted);
  }

  .milestone-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    line-height: var(--line-height-snug);
  }

  .milestone-description {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* Status Summary */
  .status-summary {
    margin-top: var(--space-2xl);
  }

  .summary-card {
    padding: var(--space-xl);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    text-align: center;
  }

  .summary-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-md);
  }

  .summary-text {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
    line-height: var(--line-height-relaxed);
  }

  .summary-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .roadmap-timeline {
      padding-left: var(--space-lg);
    }

    .milestone-marker {
      left: calc(-1 * var(--space-lg));
    }
  }
</style>
