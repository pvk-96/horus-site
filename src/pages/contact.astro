---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with the HORUS OS project team or express interest in beta testing."
>
  <div class="ambient-background"></div>
  <div class="precision-cursor" aria-hidden="true"></div>

  <Header />

  <main>
    <div class="contact-page">
      <div class="container container--sm">
        <header class="page-header">
          <h1 class="page-title">Contact</h1>
          <p class="page-lead">
            Questions, feedback, or interest in beta testing? Send a message.
          </p>
        </header>

        <div class="contact-content">
          <!-- Contact Form -->
          <section class="contact-form-section">
            <form class="contact-form" id="contact-form" data-formspree-endpoint="">
              <div class="form-notice form-notice--warning">
                <p>
                  <strong>Note:</strong> The contact form is not yet configured.
                  Please use the direct contact methods below until the Formspree endpoint is provided.
                </p>
              </div>

              <div class="form-group">
                <label for="name" class="form-label">
                  Name or Handle <span class="form-optional">(Optional)</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="form-input"
                  placeholder="How should we address you?"
                />
              </div>

              <div class="form-group">
                <label for="email" class="form-label">
                  Email Address <span class="form-required">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-input"
                  required
                  placeholder="your.email@example.com"
                />
                <span class="form-error" id="email-error" role="alert"></span>
              </div>

              <div class="form-group">
                <label for="message" class="form-label">
                  Message <span class="form-required">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  class="form-textarea"
                  required
                  rows="6"
                  placeholder="Your message..."
                ></textarea>
                <span class="form-error" id="message-error" role="alert"></span>
              </div>

              <div class="form-group">
                <label class="form-checkbox-label">
                  <input
                    type="checkbox"
                    id="beta-interest"
                    name="betaInterest"
                    value="yes"
                    class="form-checkbox"
                  />
                  <span>I'm interested in beta testing when available</span>
                </label>
              </div>

              <div class="form-actions">
                <button type="submit" class="button button--primary" disabled>
                  Send Message
                </button>
                <p class="form-note">
                  Form submissions are not currently active. Use direct contact methods below.
                </p>
              </div>

              <div class="form-notice form-notice--success" id="form-success" hidden>
                <p>
                  <strong>Message sent!</strong> Thank you for reaching out. You should receive a response within a few days.
                </p>
              </div>

              <div class="form-notice form-notice--error" id="form-error" hidden>
                <p id="form-error-message">
                  <strong>Submission failed.</strong> Please try again or use the direct contact methods below.
                </p>
              </div>
            </form>
          </section>

          <!-- Direct Contact -->
          <section class="direct-contact">
            <h2 class="section-heading">Direct Contact</h2>
            <div class="contact-methods">
              <div class="contact-method">
                <h3 class="method-label">Email</h3>
                <a href="mailto:praneethvarmakopperla@gmail.com" class="method-link">
                  praneethvarmakopperla@gmail.com
                </a>
              </div>
              <div class="contact-method">
                <h3 class="method-label">GitHub</h3>
                <a href="https://github.com/pvk-96" class="method-link" target="_blank" rel="noopener noreferrer">
                  github.com/pvk-96
                </a>
              </div>
            </div>

            <div class="privacy-note">
              <h3 class="privacy-heading">Privacy</h3>
              <p>
                When the contact form is configured, submissions will be handled by Formspree.
                Your email address is used only to respond to your message and is not shared with third parties.
                Direct email communication follows standard email privacy practices.
              </p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    // Contact form validation and submission
    const form = document.getElementById('contact-form') as HTMLFormElement | null;

    if (form) {
      const endpoint = form.dataset.formspreeEndpoint;
      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const emailInput = form.querySelector('#email') as HTMLInputElement;
      const successNotice = document.getElementById('form-success');
      const errorNotice = document.getElementById('form-error');
      const errorMessage = document.getElementById('form-error-message');

      // Enable form if endpoint is configured
      if (endpoint && endpoint.trim() !== '') {
        submitButton.disabled = false;
        const warningNotice = form.querySelector('.form-notice--warning');
        if (warningNotice) {
          warningNotice.remove();
        }
        form.querySelector('.form-note')?.remove();
      }

      // Email validation
      const validateEmail = (email: string): boolean => {
        const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return re.test(email);
      };

      // Real-time validation
      emailInput?.addEventListener('blur', () => {
        const errorEl = document.getElementById('email-error');
        if (emailInput.value && !validateEmail(emailInput.value)) {
          emailInput.classList.add('invalid');
          if (errorEl) {
            errorEl.textContent = 'Please enter a valid email address';
          }
        } else {
          emailInput.classList.remove('invalid');
          if (errorEl) {
            errorEl.textContent = '';
          }
        }
      });

      // Form submission
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!endpoint || endpoint.trim() === '') {
          return;
        }

        // Validate
        if (!validateEmail(emailInput.value)) {
          emailInput.focus();
          return;
        }

        // Disable submit button
        submitButton.disabled = true;
        submitButton.textContent = 'Sending...';

        // Hide previous notices
        if (successNotice) successNotice.hidden = true;
        if (errorNotice) errorNotice.hidden = true;

        try {
          const formData = new FormData(form);
          const response = await fetch(endpoint, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            if (successNotice) successNotice.hidden = false;
            form.reset();
          } else {
            throw new Error('Submission failed');
          }
        } catch (error) {
          if (errorNotice) {
            errorNotice.hidden = false;
            if (errorMessage) {
              errorMessage.innerHTML = '<strong>Submission failed.</strong> Please try again or use the direct contact methods below.';
            }
          }
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = 'Send Message';
        }
      });
    }
  </script>

  <script src="../scripts/ambient-background.ts"></script>
  <script src="../scripts/precision-cursor.ts"></script>
</BaseLayout>

<style>
  .contact-page {
    padding-block: var(--space-3xl);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
    text-align: center;
  }

  .page-title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-md);
  }

  .page-lead {
    font-size: var(--font-size-xl);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .contact-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  /* Contact Form */
  .contact-form {
    padding: var(--space-xl);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--border-radius-lg);
  }

  .form-group {
    margin-bottom: var(--space-lg);
  }

  .form-label {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
  }

  .form-required {
    color: var(--color-error);
  }

  .form-optional {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-normal);
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: var(--space-sm);
    font-family: inherit;
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--border-radius-sm);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-input.invalid {
    border-color: var(--color-error);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-error {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-error);
    margin-top: var(--space-xs);
  }

  .form-checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    cursor: pointer;
    color: var(--color-text-secondary);
  }

  .form-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .form-actions {
    margin-top: var(--space-xl);
    text-align: center;
  }

  .form-note {
    margin-top: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .form-notice {
    padding: var(--space-md);
    border-radius: var(--border-radius-sm);
    margin-bottom: var(--space-lg);
  }

  .form-notice--success {
    background: rgba(59, 165, 93, 0.1);
    border: 1px solid rgba(59, 165, 93, 0.3);
    color: var(--color-success);
  }

  .form-notice--error {
    background: rgba(209, 67, 67, 0.1);
    border: 1px solid rgba(209, 67, 67, 0.3);
    color: var(--color-error);
  }

  .form-notice--warning {
    background: rgba(240, 180, 41, 0.1);
    border: 1px solid rgba(240, 180, 41, 0.3);
    color: var(--color-warning);
  }

  .form-notice p {
    margin: 0;
    line-height: var(--line-height-normal);
  }

  /* Direct Contact */
  .section-heading {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-lg);
    text-align: center;
  }

  .contact-methods {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .contact-method {
    padding: var(--space-lg);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--border-radius-md);
    text-align: center;
  }

  .method-label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .method-link {
    font-size: var(--font-size-lg);
    color: var(--color-accent);
    text-decoration: none;
    word-break: break-all;
  }

  .method-link:hover {
    text-decoration: underline;
  }

  .privacy-note {
    padding: var(--space-lg);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--border-radius-md);
  }

  .privacy-heading {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }

  .privacy-note p {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (min-width: 640px) {
    .contact-methods {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
