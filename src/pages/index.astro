---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="HORUS OS">
  <div class="ambient-background"></div><div class="precision-cursor" aria-hidden="true"></div><Header />
  <main>
    <section class="hero-shell"><div class="container hero-layout">
      <div class="hero-copy"><p class="eyebrow">Independent Linux distribution / 2026</p><h1>A Linux desktop,<br /><em>built with intent.</em></h1><p class="hero-description">HORUS OS is an independent Linux distribution in development, shaped by deliberate design, practical engineering, and a focus on what matters.</p><div class="hero-actions"><a class="button button--primary" href="/project/">Read the direction <span>↗</span></a><a class="text-link" href="/roadmap/">See the work <span>→</span></a></div></div>
      <div class="hero-art" id="hero-visual" aria-label="Abstract architectural HORUS geometry">
        <div class="art-caption"><span>PLATE 01</span><span>HORUS / SYSTEM STUDY</span></div>
        <svg class="hero-geometry" viewBox="0 0 620 620" role="img" aria-label="Layered architectural linework">
          <defs><linearGradient id="gold-line" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#D4AF37" /><stop offset="1" stop-color="#6f5312" /></linearGradient></defs>
          <g data-hero-orbit class="hero-geometry__orbit"><ellipse cx="310" cy="310" rx="258" ry="128" /><ellipse cx="310" cy="310" rx="211" ry="77" /></g>
          <g data-hero-geometry class="hero-geometry__core"><path class="plate-back" d="M310 82 505 194 505 426 310 538 115 426 115 194Z" /><path class="plate-front" d="M310 143 451 225 451 395 310 477 169 395 169 225Z" /><path data-hero-facet d="M310 82v456M115 194l390 232M505 194 115 426" /><path data-hero-facet d="m169 225 141 82 141-82M169 395l141-88 141 88" /></g>
          <path data-hero-marker class="hero-geometry__marker" d="M291 310h38M310 291v38" />
        </svg>
        <div class="art-index"><span>ARCH / 01</span><span>DELTA 0.1</span></div>
      </div>
    </div></section>
    <section class="signal-band"><div class="container signal-grid"><span>Current focus</span><strong>Boot infrastructure</strong><strong>Installation workflow</strong><strong>Desktop integration</strong><span class="signal-mark">No public release</span></div></section>
    <section class="section intro-section"><div class="container intro-grid"><p class="section-index">01 / POSITION</p><div><h2>Engineering a cohesive experience.</h2><p>HORUS OS is an Arch-based Linux distribution being developed around a considered approach to the desktop experience. It aims to bring together system engineering, visual identity, and practical design into a distribution that feels intentional rather than assembled.</p><p>The project is currently in active development. Reliable boot infrastructure, installation workflows, and desktop integration come before release claims.</p><a class="text-link" href="/project/">Understand the foundation <span>→</span></a></div></div></section>
    <section class="section principles-section"><div class="container"><div class="section-head"><p class="section-index">02 / PRINCIPLES</p><h2>A system should explain itself.</h2></div><div class="principles-list"><article><span>01</span><h3>Considered</h3><p>Every decision, from boot sequence to desktop behavior, is made deliberately and documented clearly.</p></article><article><span>02</span><h3>Maintainable</h3><p>Engineering choices prioritize long-term maintainability over short-term convenience.</p></article><article><span>03</span><h3>Cohesive</h3><p>Visual identity, system behavior, and technical architecture work as parts of one whole.</p></article><article><span>04</span><h3>Honest</h3><p>Development progress is communicated accurately. Planned work is not presented as finished.</p></article></div></div></section>
    <section class="section closing-section"><div class="container closing-layout"><div><p class="section-index">03 / NEXT</p><h2>Follow the build<br />as it becomes real.</h2></div><div><p>Six engineering milestones define the route from bootable foundation to a qualified distribution.</p><a class="button button--secondary" href="/roadmap/">Open the roadmap <span>↗</span></a></div></div></section>
  </main><Footer />
  <script src="../scripts/hero-animation.ts"></script><script src="../scripts/ambient-background.ts"></script><script src="../scripts/precision-cursor.ts"></script>
</BaseLayout>
<style>
  .hero-shell { min-height: calc(100vh - 76px); display: flex; align-items: flex-start; border-bottom: 1px solid var(--color-border-subtle); }
  .hero-layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr); gap: clamp(2rem, 7vw, 8rem); align-items: start; padding-block: clamp(2.75rem, 4.5vw, 4.75rem) clamp(4rem, 7vw, 7rem); }
  .hero-copy { position: relative; z-index: 1; }
  .hero-copy h1 { max-width: 8.5ch; margin-top: 1.6rem; font-size: clamp(3.2rem, 5.8vw, 6.8rem); font-weight: var(--font-weight-semibold); }
  .hero-copy h1 em { color: var(--color-gold-primary); font-style: normal; }
  .hero-description { max-width: 43ch; margin-top: 2rem; color: var(--color-text-secondary); font-size: var(--font-size-lg); line-height: var(--line-height-relaxed); }
  .hero-actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2.5rem; }
  .hero-actions .button span, .closing-section .button span { margin-left: 1rem; }
  .text-link { display: inline-flex; gap: .75rem; align-items: center; color: var(--color-text-secondary); font-size: var(--font-size-sm); }
  .text-link span { color: var(--color-gold-primary); transition: transform var(--duration-base) var(--ease-out); }
  .text-link:hover span { transform: translateX(5px); }
  .hero-art { position: relative; min-height: min(62vw, 680px); margin-top: clamp(.25rem, 1vw, 1rem); display: grid; place-items: center; border-left: 1px solid var(--color-border-subtle); background: linear-gradient(135deg, rgba(17,24,39,.12), transparent 60%); }
  .hero-art::before { content: ''; position: absolute; inset: 12% 7%; border: 1px solid rgba(212,175,55,.17); transform: skewY(-12deg); }
  .hero-geometry { position: relative; width: min(100%, 620px); overflow: visible; }
  .hero-geometry polygon, .hero-geometry path, .hero-geometry ellipse { fill: none; stroke: url(#gold-line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .hero-geometry__core, .hero-geometry__orbit { transform-box: fill-box; transform-origin: center; }
  .plate-back { opacity: .28; stroke-width: 1.5 !important; }.plate-front { opacity: .65; stroke-width: 1.7 !important; }.hero-geometry__orbit { opacity: .35; stroke-dasharray: 2 12; }.hero-geometry__marker { opacity: .85; stroke-width: 2 !important; }
  .art-caption, .art-index { position: absolute; left: 1.25rem; right: 1.25rem; display: flex; justify-content: space-between; color: var(--color-text-muted); font: .62rem var(--font-family-mono); letter-spacing: .12em; }.art-caption { top: 1.25rem; }.art-index { bottom: 1.25rem; color: var(--color-gold-accent); }
  .signal-band { border-bottom: 1px solid var(--color-border-subtle); background: rgba(17,24,39,.72); }.signal-grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr) 1.2fr; gap: 1rem; padding-block: 1.25rem; color: var(--color-text-muted); font: .65rem var(--font-family-mono); text-transform: uppercase; letter-spacing: .08em; }.signal-grid strong { color: var(--color-text-secondary); font-weight: 500; }.signal-mark { text-align: right; color: var(--color-gold-accent); }
  .section { padding-block: var(--section-padding-block); }.intro-section { background: rgba(17,24,39,.7); }.intro-grid, .closing-layout { display: grid; grid-template-columns: .75fr 1.25fr; gap: 4rem; }.section-index { color: var(--color-gold-primary); font: .68rem var(--font-family-mono); letter-spacing: .12em; }.intro-grid h2, .closing-section h2 { max-width: 12ch; margin-bottom: 2rem; font-size: var(--font-size-3xl); font-weight: 600; }.intro-grid p:not(.section-index), .closing-section div:last-child > p { max-width: 62ch; color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }.intro-grid p + p { margin-top: 1rem; }.intro-grid .text-link { margin-top: 2rem; }
  .section-head { display: grid; grid-template-columns: .75fr 1.25fr; gap: 4rem; margin-bottom: 4rem; }.section-head h2 { max-width: 14ch; font-size: var(--font-size-3xl); }.principles-list { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--color-border); }.principles-list article { min-height: 16rem; padding: 1.5rem 1.25rem 1.5rem 0; border-right: 1px solid var(--color-border-subtle); }.principles-list article:not(:first-child) { padding-left: 1.25rem; }.principles-list span { color: var(--color-gold-primary); font: .7rem var(--font-family-mono); }.principles-list h3 { margin-top: 3.5rem; margin-bottom: .75rem; font-family: var(--font-family-mono); font-size: var(--font-size-sm); letter-spacing: .08em; text-transform: uppercase; }.principles-list p { color: var(--color-text-muted); font-size: .9rem; line-height: 1.7; }.closing-section { background: var(--color-midnight); }.closing-layout > div:last-child { align-self: end; }.closing-layout > div:last-child > p { margin-bottom: 2rem; }
  @media (max-width: 900px) { .hero-shell { min-height: auto; }.hero-layout { grid-template-columns: 1fr; padding-top: 2.5rem; }.hero-art { min-height: 440px; margin-top: 1rem; border-left: 0; border-top: 1px solid var(--color-border-subtle); }.signal-grid { grid-template-columns: repeat(2, 1fr); }.signal-grid span:first-child { grid-column: 1 / -1; }.signal-mark { text-align: left; }.intro-grid, .closing-layout, .section-head { grid-template-columns: 1fr; gap: 2rem; }.principles-list { grid-template-columns: repeat(2, 1fr); }.principles-list article:nth-child(2) { border-right: 0; } }
  @media (max-width: 560px) { .hero-copy h1 { font-size: clamp(3rem, 15vw, 4.2rem); }.hero-actions { align-items: flex-start; flex-direction: column; }.hero-art { min-height: 330px; }.principles-list { grid-template-columns: 1fr; }.principles-list article, .principles-list article:not(:first-child) { min-height: auto; padding: 1.5rem 0; border-right: 0; border-bottom: 1px solid var(--color-border-subtle); }.principles-list h3 { margin-top: 1.5rem; }.signal-grid { grid-template-columns: 1fr; }.signal-grid span:first-child { grid-column: auto; } }
</style>
