---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';
const entry = await getEntry('notes', 'developer-note');
if (!entry) throw new Error('Developer note not found');
const { Content } = await entry.render();
---
<BaseLayout title="Developer's Note" description="A note from the developer on building HORUS OS with intention and practical engineering.">
<div class="ambient-background"></div><div class="precision-cursor" aria-hidden="true"></div><Header />
<main class="note-page"><div class="container container--sm"><header class="page-header"><p class="page-kicker">Journal / Developer's Note</p></header><article class="prose"><Content /></article></div></main><Footer />
<script src="../scripts/ambient-background.ts"></script><script src="../scripts/precision-cursor.ts"></script>
</BaseLayout>
<style>
.note-page { padding-bottom: var(--space-3xl); }.prose { padding-block: var(--space-2xl); color: var(--color-text-secondary); font-size: 1.08rem; line-height: 1.9; }.prose :global(h1) { max-width: 12ch; margin-bottom: 2rem; color: var(--color-text-primary); font-size: var(--font-size-3xl); line-height: 1.05; }.prose :global(h2) { margin-top: 4rem; margin-bottom: 1.25rem; color: var(--color-text-primary); font-size: var(--font-size-2xl); }.prose :global(h3) { margin-top: 2.5rem; margin-bottom: .8rem; color: var(--color-gold-accent); font: .85rem var(--font-family-mono); letter-spacing: .08em; text-transform: uppercase; }.prose :global(p) { margin-bottom: 1.5rem; }.prose :global(strong) { color: var(--color-text-primary); }.prose :global(blockquote) { margin: 2rem 0; padding-left: 1.25rem; border-left: 1px solid var(--color-gold-primary); color: var(--color-text-muted); }.prose :global(code) { color: var(--color-gold-primary); font-family: var(--font-family-mono); font-size: .85em; }.prose :global(ul),.prose :global(ol){padding-left:1.4rem}.prose :global(li){margin-bottom:.6rem}
</style>
