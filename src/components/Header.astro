---
const navigation = [
  { label: 'Home', href: '/' }, { label: 'Project', href: '/project/' },
  { label: 'Roadmap', href: '/roadmap/' }, { label: "Developer's Note", href: '/developer-note/' }, { label: 'Contact', href: '/contact/' }
];
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="HORUS OS home"><img src="/images/symbol.svg" alt="" width="30" height="30" /><span>HORUS <small>OS</small></span></a>
    <span class="header-status"><i></i> IN DEVELOPMENT / ARCH-BASED</span>
    <nav class="nav-desktop" aria-label="Primary"><ul class="nav-list">{navigation.map(item => <li><a href={item.href} class:list={['nav-link', { active: currentPath === item.href }]} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a></li>)}</ul></nav>
    <button class="mobile-menu-toggle" aria-label="Open navigation menu" aria-expanded="false" type="button"><span></span><span></span></button>
  </div>
  <div class="mobile-menu" hidden><nav aria-label="Mobile"><ul>{navigation.map(item => <li><a href={item.href} class:list={['mobile-nav-link', { active: currentPath === item.href }]} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a></li>)}</ul></nav></div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-sticky); border-bottom: 1px solid var(--color-border-subtle); background: rgba(11,16,24,.86); backdrop-filter: blur(18px); }
  .header-inner { display: flex; align-items: center; gap: 2rem; min-height: 76px; }
  .logo { display: flex; align-items: center; gap: .65rem; color: var(--color-text-primary); font-family: var(--font-family-mono); font-size: .8rem; letter-spacing: .08em; }
  .logo img { width: 30px; height: 30px; }
  .logo small { color: var(--color-gold-primary); font-size: .65em; }
  .header-status { margin-right: auto; color: var(--color-text-muted); font-family: var(--font-family-mono); font-size: .62rem; letter-spacing: .1em; }
  .header-status i { display: inline-block; width: 5px; height: 5px; margin-right: .4rem; border-radius: 50%; background: var(--color-success); }
  .nav-list { display: flex; gap: clamp(1rem, 2.5vw, 2.25rem); list-style: none; padding: 0; margin: 0; }
  .nav-link { position: relative; display: block; padding-block: .5rem; color: var(--color-text-muted); font-family: var(--font-family-mono); font-size: .74rem; letter-spacing: .015em; transition: color var(--duration-base) var(--ease-out); }
  .nav-link:hover, .nav-link.active { color: var(--color-text-primary); }
  .nav-link.active::after { content: ''; position: absolute; bottom: -.2rem; left: 0; width: 1.5rem; height: 2px; background: var(--color-gold-primary); }
  .mobile-menu-toggle { display: none; width: 42px; height: 42px; margin-left: auto; border: 1px solid var(--color-border-subtle); background: transparent; }
  .mobile-menu-toggle span { display: block; width: 17px; height: 1px; margin: 4px auto; background: var(--color-text-primary); transition: transform var(--duration-base) var(--ease-out); }
  .mobile-menu { border-top: 1px solid var(--color-border-subtle); background: var(--color-bg-surface); }
  .mobile-menu ul { list-style: none; padding: 1rem var(--container-padding-inline); margin: 0; }
  .mobile-nav-link { display: block; padding: .85rem 0; color: var(--color-text-secondary); border-bottom: 1px solid var(--color-border-subtle); font-family: var(--font-family-mono); font-size: .82rem; }
  .mobile-nav-link.active { color: var(--color-gold-primary); }
  @media (max-width: 850px) { .header-status, .nav-desktop { display: none; } .mobile-menu-toggle { display: block; } }
</style>
<script>
  const toggle = document.querySelector('.mobile-menu-toggle') as HTMLButtonElement | null;
  const menu = document.querySelector('.mobile-menu') as HTMLElement | null;
  if (toggle && menu) {
    toggle.addEventListener('click', () => { const expanded = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!expanded)); menu.hidden = expanded; });
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { toggle.setAttribute('aria-expanded', 'false'); menu.hidden = true; }));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && !menu.hidden) { toggle.setAttribute('aria-expanded', 'false'); menu.hidden = true; toggle.focus(); } });
  }
</script>
